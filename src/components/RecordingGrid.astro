---
import { Picture } from "astro:assets"
import { displayDate, projectUrl, type Project } from "../lib/projects"

interface Props {
  recordings: Project[]
}

const { recordings } = Astro.props
---

<ul class="grid">
  {
    recordings.map((project) => {
      const { title, credit, summary, image, imageAlt } = project.data
      return (
        <li class="record">
          <div class="cover">
            <Picture
              src={image}
              alt={imageAlt}
              widths={[300, 500, 700]}
              sizes="(max-width: 620px) 50vw, (max-width: 900px) 33vw, 20vw"
              formats={["avif"]}
              fallbackFormat="webp"
            />
          </div>
          <p class="meta label">{displayDate(project)}</p>
          <h2>
            <a href={projectUrl(project)}>{title}</a>
          </h2>
          <p class="credit">{credit}</p>
          {summary && <p class="summary">{summary}</p>}
        </li>
      )
    })
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 56px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .record {
    position: relative;
  }

  .cover {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--placeholder);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .record:hover .cover :global(img),
  .record:focus-within .cover :global(img) {
    transform: scale(1.02);
  }

  .meta {
    margin: 14px 0 6px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  h2 {
    margin: 10px 0 6px;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* The title link covers the whole record. */
  h2 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .record:hover h2 a {
    color: var(--blue);
  }

  .credit,
  .summary {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .credit {
    color: var(--ink-soft);
  }

  .summary {
    margin-top: 4px;
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 16px;
    }

    h2 {
      font-size: 19px;
    }
  }
</style>
