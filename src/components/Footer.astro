---
import { site } from "../data/site"
import siteBuilderLogo from "../assets/Scordatura_Logo_White.svg"
---

<footer id="contact" class="on-dark">
  <div class="call">
    <span class="label">(03) Enquiries</span>
    <h2 class="display">Have a project?</h2>
    <a href={`mailto:${site.email}`}>
      Send me a message
      <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="bottom label">
    <a class="builder" target="_blank" href={site.siteBuilderUrl}>
      <img
        src={siteBuilderLogo.src}
        width={siteBuilderLogo.width}
        height={siteBuilderLogo.height}
        alt={`Site by ${site.siteBuilder}`}
      />
    </a>
    <span class="location">{site.location}</span>
    <a href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  footer {
    padding: 115px var(--gutter) 24px;
    background: var(--blue);
    color: var(--paper);
  }

  h2 {
    margin: 18px 0 76px;
    font-size: clamp(66px, 11vw, 162px);
  }

  .call > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 27px 0;
    border-top: 1px solid rgb(242 240 233 / 0.5);
    border-bottom: 1px solid rgb(242 240 233 / 0.5);
    font-family: var(--serif);
    font-size: clamp(24px, 4vw, 60px);
    overflow-wrap: anywhere;
    transition: padding var(--ease);
  }

  .call > a:hover {
    padding-inline: 12px;
  }

  .call > a span {
    font-family: var(--sans);
    font-size: 24px;
    transition: transform var(--ease);
  }

  .call > a:hover span {
    transform: translate(4px, -4px);
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 85px;
  }

  .builder img {
    width: auto;
    height: 22px;
    opacity: 0.85;
    transition: opacity var(--ease);
  }

  .builder:hover img {
    opacity: 1;
  }

  @media (max-width: 620px) {
    footer {
      padding-top: 85px;
    }

    h2 {
      margin-bottom: 55px;
    }

    .bottom {
      padding-top: 65px;
    }

    .location {
      display: none;
    }
  }
</style>
