---
import ProjectCard from "./ProjectCard.astro"
import Archive from "./Archive.astro"
import { pad, type Project } from "../lib/projects"

interface Props {
  featured: Project[]
  all: Project[]
}

const { featured, all } = Astro.props
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="carousel" data-carousel>
    <div class="intro">
      <div>
        <span class="label">(01) Selected work</span>
        <h2 class="display" id="work-title">Featured projects</h2>
      </div>
      <!-- Hidden until the script runs; without JavaScript the track still scrolls. -->
      <div class="controls" data-controls hidden>
        <span class="label counter" aria-hidden="true">
          <span data-current>01</span> / {pad(featured.length)}
        </span>
        <button type="button" data-prev aria-label="Previous project">←</button>
        <button type="button" data-next aria-label="Next project">→</button>
      </div>
    </div>

    <ul class="track" data-track aria-label="Featured projects">
      {featured.map((project, i) => <ProjectCard project={project} number={i + 1} />)}
    </ul>

    <div class="progress" aria-hidden="true"><span data-progress></span></div>
  </div>

  <Archive projects={all} />
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-carousel]")!
  const track = root.querySelector<HTMLElement>("[data-track]")!
  const slides = [...track.children] as HTMLElement[]
  const prev = root.querySelector<HTMLButtonElement>("[data-prev]")!
  const next = root.querySelector<HTMLButtonElement>("[data-next]")!
  const current = root.querySelector("[data-current]")!
  const progress = root.querySelector<HTMLElement>("[data-progress]")!
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)")

  // Slides snap to the track's left padding, so positions are measured from there.
  const start = () => parseFloat(getComputedStyle(track).paddingLeft)
  const maxScroll = () => track.scrollWidth - track.clientWidth

  function index() {
    if (track.scrollLeft >= maxScroll() - 2) return slides.length - 1
    const left = track.scrollLeft + start()
    let best = 0
    slides.forEach((slide, i) => {
      if (Math.abs(slide.offsetLeft - left) < Math.abs(slides[best].offsetLeft - left)) best = i
    })
    return best
  }

  function go(i: number) {
    const slide = slides[Math.max(0, Math.min(slides.length - 1, i))]
    track.scrollTo({
      left: slide.offsetLeft - start(),
      behavior: reduceMotion.matches ? "auto" : "smooth",
    })
  }

  let frame = 0
  function update() {
    cancelAnimationFrame(frame)
    frame = requestAnimationFrame(() => {
      const i = index()
      current.textContent = String(i + 1).padStart(2, "0")
      prev.disabled = track.scrollLeft <= 2
      next.disabled = track.scrollLeft >= maxScroll() - 2
      const fraction = maxScroll() > 0 ? track.scrollLeft / maxScroll() : 1
      const segment = 1 / slides.length
      progress.style.transform = `scaleX(${segment + (1 - segment) * fraction})`
    })
  }

  prev.addEventListener("click", () => go(index() - 1))
  next.addEventListener("click", () => go(index() + 1))
  track.addEventListener("scroll", update, { passive: true })
  addEventListener("resize", update)

  root.querySelector<HTMLElement>("[data-controls]")!.hidden = false
  root.classList.add("is-enhanced")
  update()
</script>

<style>
  .work {
    padding-top: clamp(64px, 11svh, var(--section-space));
  }

  /* Sized so the whole carousel sits within one screen. */
  .carousel {
    --slide-h: clamp(220px, 50svh, 540px);
  }

  .intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(24px, 4svh, 44px);
    padding-inline: var(--gutter);
  }

  h2 {
    margin-top: 14px;
    font-size: clamp(48px, 6vw, 92px);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .controls[hidden] {
    display: none;
  }

  .counter {
    margin-right: 10px;
    color: var(--muted);
  }

  .counter span {
    color: var(--ink);
  }

  .controls button {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    cursor: pointer;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    font-size: 18px;
    transition:
      background var(--ease),
      color var(--ease),
      opacity var(--ease);
  }

  .controls button:hover:not(:disabled) {
    background: var(--ink);
    color: var(--paper);
  }

  .controls button:disabled {
    cursor: default;
    opacity: 0.3;
  }

  .track {
    position: relative;
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0 var(--gutter) 20px;
    overflow-x: auto;
    list-style: none;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
  }

  /* The progress line replaces the scrollbar once the controls work. */
  .is-enhanced .track {
    scrollbar-width: none;
  }

  .is-enhanced .track::-webkit-scrollbar {
    display: none;
  }

  .progress {
    display: none;
    height: 1px;
    margin: 8px var(--gutter) 0;
    background: var(--line);
  }

  .is-enhanced .progress {
    display: block;
  }

  .progress span {
    display: block;
    height: 2px;
    margin-top: -0.5px;
    background: var(--ink);
    transform-origin: left;
    transition: transform 120ms linear;
  }

  @media (max-width: 620px) {
    .carousel {
      --slide-h: clamp(220px, 44svh, 110vw);
    }

    .intro {
      align-items: start;
      flex-direction: column;
      gap: 18px;
    }

    .track {
      gap: 16px;
    }

    .controls button {
      width: 42px;
      height: 42px;
    }
  }
</style>
