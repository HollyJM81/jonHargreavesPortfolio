---
import ProjectCard from "./ProjectCard.astro"
import Archive from "./Archive.astro"
import { ROLES } from "../data/roles"
import { pad, type Project } from "../lib/projects"

interface Props {
  featured: Project[]
  archive: Project[]
}

const { featured, archive } = Astro.props
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="heading">
    <div>
      <span class="label">(01) Selected work</span>
      <h2 class="display" id="work-title">Recent projects</h2>
    </div>
    <p>Filter the work by role, or search by collaborator, keyword or idea.</p>
  </div>

  <!-- Hidden until the script runs; without JavaScript every project is shown. -->
  <div class="filter-bar" data-filter-bar hidden>
    <div class="roles" role="group" aria-label="Filter projects by role">
      <button type="button" class="label" data-role="" aria-pressed="true">All</button>
      {
        ROLES.map((role) => (
          <button type="button" class="label" data-role={role} aria-pressed="false">
            {role}
          </button>
        ))
      }
    </div>
    <label class="search">
      <span class="sr-only">Search projects</span>
      <input type="search" class="label" placeholder="Search work" data-search />
    </label>
  </div>

  <p class="results label" aria-live="polite">
    <span>
      Showing <span data-count>{pad(featured.length)}</span> / {pad(featured.length)}
    </span>
    <span data-role-label>All practices</span>
  </p>

  <ul class="grid" data-grid>
    {featured.map((project, i) => <ProjectCard project={project} number={i + 1} />)}
  </ul>

  <div class="empty" data-empty hidden>
    <p>No featured work found.</p>
    <div>
      <button type="button" class="label" data-clear>Clear search</button>
      <a class="label" href="#archive">Browse the archive</a>
    </div>
  </div>

  <Archive projects={archive} startAt={featured.length + 1} />
</section>

<script>
  const bar = document.querySelector<HTMLElement>("[data-filter-bar]")!
  const buttons = [...bar.querySelectorAll<HTMLButtonElement>("[data-role]")]
  const search = bar.querySelector<HTMLInputElement>("[data-search]")!
  const cards = [...document.querySelectorAll<HTMLElement>("[data-grid] > li")]
  const count = document.querySelector("[data-count]")!
  const roleLabel = document.querySelector("[data-role-label]")!
  const empty = document.querySelector<HTMLElement>("[data-empty]")!

  // The URL holds the role lower-cased (?role=conductor); match it case-insensitively.
  const requested = (new URLSearchParams(location.search).get("role") ?? "").toLowerCase()
  let activeRole = buttons.find((b) => b.dataset.role!.toLowerCase() === requested)?.dataset.role ?? ""

  function apply() {
    const term = search.value.trim().toLowerCase()
    let visible = 0
    for (const card of cards) {
      const matchesRole = !activeRole || card.dataset.roles!.split("|").includes(activeRole)
      const matchesTerm = !term || card.dataset.search!.includes(term)
      card.hidden = !(matchesRole && matchesTerm)
      if (!card.hidden) visible++
    }
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.role === activeRole))
    count.textContent = String(visible).padStart(2, "0")
    roleLabel.textContent = activeRole || "All practices"
    empty.hidden = visible > 0

    const url = new URL(location.href)
    if (activeRole) url.searchParams.set("role", activeRole.toLowerCase())
    else url.searchParams.delete("role")
    history.replaceState(null, "", url)
  }

  for (const b of buttons) {
    b.addEventListener("click", () => {
      activeRole = b.dataset.role!
      apply()
    })
  }
  search.addEventListener("input", apply)
  document.querySelector("[data-clear]")!.addEventListener("click", () => {
    search.value = ""
    activeRole = ""
    apply()
  })

  bar.hidden = false
  apply()
</script>

<style>
  .work {
    padding: var(--section-space) var(--gutter) 0;
  }

  .heading {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: end;
    gap: 60px;
    margin-bottom: 80px;
  }

  h2 {
    margin-top: 18px;
    font-size: clamp(64px, 8vw, 116px);
  }

  .heading > p {
    max-width: 420px;
    margin: 0;
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.5;
  }

  .filter-bar {
    position: sticky;
    z-index: 10;
    top: 0;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }

  .filter-bar[hidden] {
    display: none;
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
  }

  .roles button {
    position: relative;
    padding: 18px 14px;
    cursor: pointer;
    border: 0;
    background: transparent;
    color: var(--muted);
    transition: color var(--ease);
  }

  .roles button:first-child {
    padding-left: 0;
  }

  .roles button::after {
    position: absolute;
    right: 14px;
    bottom: -1px;
    left: 14px;
    height: 2px;
    content: "";
  }

  .roles button:first-child::after {
    left: 0;
  }

  .roles button:hover,
  .roles button[aria-pressed="true"] {
    color: var(--blue);
  }

  .roles button[aria-pressed="true"]::after {
    background: var(--blue);
  }

  .search {
    display: flex;
    width: 230px;
    align-items: center;
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }

  .search input {
    width: 100%;
    border: 0;
    background: transparent;
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .results {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 20px 0 48px;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 86px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    display: flex;
    min-height: 340px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--ink);
  }

  .empty[hidden] {
    display: none;
  }

  .empty p {
    margin: 0 0 20px;
    font-family: var(--serif);
    font-size: 48px;
    text-align: center;
  }

  .empty div {
    display: flex;
    gap: 24px;
  }

  .empty button,
  .empty a {
    padding: 0;
    cursor: pointer;
    border: 0;
    border-bottom: 1px solid;
    background: transparent;
  }

  @media (max-width: 900px) {
    .heading {
      grid-template-columns: 1fr;
    }

    .filter-bar {
      flex-direction: column;
      align-items: start;
      gap: 0;
    }

    .search {
      width: 100%;
      padding: 14px 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }

  @media (max-width: 620px) {
    .heading {
      margin-bottom: 55px;
    }

    .filter-bar {
      position: relative;
    }

    .roles button {
      padding: 13px 9px;
    }

    .grid {
      row-gap: 68px;
    }
  }
</style>
