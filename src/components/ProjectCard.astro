---
import { Picture } from "astro:assets"
import { displayDate, pad, projectUrl, type Project } from "../lib/projects"

interface Props {
  project: Project
  number: number
}

const { project, number } = Astro.props
const { title, credit, summary, image, imageAlt } = project.data
---

<li class="card">
  <div class="image">
    <Picture
      src={image}
      alt={imageAlt}
      widths={[500, 800, 1100]}
      sizes="(max-width: 620px) 85vw, 650px"
      formats={["avif"]}
      fallbackFormat="webp"
    />
  </div>
  <div class="meta label">
    <span>{credit}</span>
  </div>
  <h3><a href={projectUrl(project)}>{title}</a></h3>
  {summary && <p>{summary}</p>}
</li>

<style>
  .card {
    position: relative;
    flex: 0 0 auto;
    width: min(calc(var(--slide-h) * 1.3), calc(100vw - var(--gutter) * 2 - 40px));
    scroll-snap-align: start;
    margin: 60px;
  }

  .image {
    height: var(--slide-h);
    overflow: hidden;
    background: var(--placeholder);
  }

  .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) saturate(0.6);
    transition:
      transform 500ms ease,
      filter 300ms ease;
  }

  .card:hover .image :global(img),
  .card:focus-within .image :global(img) {
    filter: grayscale(0) saturate(0.85);
    transform: scale(1.015);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0 10px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .meta span:first-child {
    flex: none;
  }

  .meta span:last-child {
    overflow: hidden;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  h3 {
    margin: 16px 0 6px;
    font-family: var(--serif);
    font-size: clamp(26px, 2.4vw, 38px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  /* The title link covers the whole card. */
  h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .card:hover h3 a {
    color: var(--blue);
  }

  p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: var(--text-small);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
